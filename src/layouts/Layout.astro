---
// Shell do documento: head (fontes + folha global), camadas de fundo,
// cabeçalho, slot com o conteúdo da página e rodapé.
//
// Nada de <script> de terceiro no <head>. Tailwind, GSAP e Lucide vêm
// do npm: o Tailwind vira CSS no build, o GSAP entra nos módulos das
// seções que animam e o Lucide no módulo de ícones abaixo — todos
// adiados, nenhum bloqueando a renderização.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth overflow-x-hidden">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="icon" href="/favicon.ico"/>
<meta name="generator" content={Astro.generator}/>

<!-- Anti-FOUC. Precisa rodar síncrono, antes do primeiro pixel: é ele
     que liga a regra .js [data-reveal]{opacity:0}. Com defer, ou como
     módulo, o conteúdo apareceria antes e piscaria quando o GSAP o
     escondesse para animar. São 52 bytes inline, sem requisição. -->
<script is:inline>document.documentElement.classList.add('js');</script>

<!-- Google Fonts — Bricolage Grotesque (display, do design system) +
     Inter + JetBrains Mono.
     Os dois preconnect abrem DNS + TCP + TLS para os domínios da
     Google em paralelo com o parse, então a folha de fontes já
     encontra a conexão de pé; display=swap desenha o texto na fonte
     do sistema enquanto a web font baixa, em vez de deixar a primeira
     dobra em branco. -->
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
/>


</head>

<body class="min-h-screen bg-bg text-white overflow-x-hidden antialiased relative">

<!-- ============================================================
     CAMADAS DE FUNDO
     ============================================================ -->
<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true">
  <div class="stars absolute inset-0"></div>
  <div class="dot-grid absolute inset-0"></div>
  <div class="grid-bg-mask absolute inset-0"></div>
  <!-- Orbes de profundidade -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[140vw] h-[320px] max-w-[900px] rounded-full bg-accent/10 blur-[90px] sm:h-[520px] sm:blur-[130px]"></div>
  <div class="absolute bottom-0 right-0 w-[100vw] h-[100vw] max-w-[620px] max-h-[620px] rounded-full bg-accentlo/10 blur-[90px] sm:blur-[110px]"></div>
  <div class="absolute top-1/3 -left-40 w-[90vw] h-[90vw] max-w-[520px] max-h-[520px] rounded-full bg-accent2/10 blur-[90px] sm:blur-[130px]"></div>
  <!-- Vinheta -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(5,5,5,.85)_100%)]"></div>
</div>

<Header />

<slot />

<Footer />

<!-- Troca os <i data-lucide> por <svg> em todo o documento.
     Vive no layout, e não no script de uma seção: os ícones estão
     espalhados por cabeçalho, dobras e rodapé, e um createIcons() por
     componente pagaria a varredura do documento várias vezes.
     Astro trata este <script> como módulo: ele é agrupado, sai com
     hash e roda adiado, depois do parse. -->
<script>
  import '../scripts/icons.ts';
</script>

</body>
</html>

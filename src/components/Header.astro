---
// Cabeçalho do site: nav desktop (pílula central) + menu mobile.
// O componente carrega o próprio comportamento do menu — ver o <script> no fim.
---

<header class="relative z-50">
  <nav class="relative mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-5 sm:px-6 sm:py-6" data-reveal="nav">
    <div class="beam-border-h"></div>

    <!-- Logo -->
    <a href="#" class="flex items-center gap-2.5 group">
      <span class="relative flex items-center justify-center w-8 h-8">
        <i data-lucide="asterisk" class="absolute w-8 h-8 text-white rotate-45"></i>
        <i data-lucide="asterisk" class="absolute w-8 h-8 text-accent transition-transform duration-700 group-hover:rotate-90"></i>
      </span>
      <span class="text-xl tracking-tight">Opris</span>
    </a>

    <!-- Menu central -->
    <div class="hidden md:flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-1 py-1 backdrop-blur-md">
      <a href="#" class="flex items-center gap-2 rounded-full border border-white/5 bg-neutral-800/80 px-4 py-1.5 text-xs shadow-inner">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Início
      </a>
      <a href="#arquitetura" class="px-4 py-1.5 text-xs text-neutral-400 transition-colors hover:text-white">Soluções</a>
      <a href="#processo" class="px-4 py-1.5 text-xs text-neutral-400 transition-colors hover:text-white">Processo</a>
      <a href="#resultados" class="px-4 py-1.5 text-xs text-neutral-400 transition-colors hover:text-white">Resultados</a>
    </div>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a href="#contato" class="hidden sm:block rounded-full border-t border-white/20 bg-gradient-to-b from-accenthi to-accentlo px-5 py-2 text-sm shadow-[0_0_15px_-3px_rgba(249,115,22,.4)] transition-all hover:brightness-110">
        Falar com especialista
      </a>
      <button id="btn-menu" type="button"
              class="-mr-2 flex h-11 w-11 items-center justify-center text-neutral-300 transition-colors hover:text-white md:hidden"
              aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-mobile">
        <i data-lucide="menu" class="h-5 w-5" data-menu-icon="open"></i>
        <i data-lucide="x" class="hidden h-5 w-5" data-menu-icon="close"></i>
      </button>
    </div>
  </nav>

  <!-- Menu mobile (mesmos links do menu central) -->
  <div id="menu-mobile" class="hidden border-b border-white/5 bg-bg/95 backdrop-blur-md md:hidden">
    <div class="mx-auto flex max-w-7xl flex-col px-4 pb-5 pt-2 sm:px-6">
      <a href="#" class="flex items-center gap-2 rounded-lg px-3 py-3 text-sm text-white transition-colors hover:bg-white/5">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Início
      </a>
      <a href="#arquitetura" class="rounded-lg px-3 py-3 text-sm text-neutral-400 transition-colors hover:bg-white/5 hover:text-white">Soluções</a>
      <a href="#processo" class="rounded-lg px-3 py-3 text-sm text-neutral-400 transition-colors hover:bg-white/5 hover:text-white">Processo</a>
      <a href="#resultados" class="rounded-lg px-3 py-3 text-sm text-neutral-400 transition-colors hover:bg-white/5 hover:text-white">Resultados</a>
      <a href="#contato" class="mt-3 rounded-full border-t border-white/20 bg-gradient-to-b from-accenthi to-accentlo px-5 py-3 text-center text-sm shadow-[0_0_15px_-3px_rgba(249,115,22,.4)] transition-all hover:brightness-110 sm:hidden">
        Falar com especialista
      </a>
    </div>
  </div>
</header>

<script>
  /* ---------- Menu mobile ----------
     Script de componente (módulo, adiado pelo Astro). Roda depois do
     lucide.createIcons() do layout, que troca os <i data-lucide> por <svg> —
     guardar as referências antes deixaria os ícones apontando para nós já
     descartados e o toggle não surtiria efeito. */
  const btnMenu = document.getElementById('btn-menu');
  const menuMobile = document.getElementById('menu-mobile');

  if (btnMenu && menuMobile) {
    const iconeAbrir = btnMenu.querySelector('[data-menu-icon="open"]');
    const iconeFechar = btnMenu.querySelector('[data-menu-icon="close"]');

    const alternarMenu = (abrir: boolean) => {
      menuMobile.classList.toggle('hidden', !abrir);
      btnMenu.setAttribute('aria-expanded', abrir ? 'true' : 'false');
      btnMenu.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
      if (iconeAbrir) iconeAbrir.classList.toggle('hidden', abrir);
      if (iconeFechar) iconeFechar.classList.toggle('hidden', !abrir);
    };

    btnMenu.addEventListener('click', () => {
      alternarMenu(menuMobile.classList.contains('hidden'));
    });

    /* Fecha ao navegar para uma âncora */
    menuMobile.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => alternarMenu(false));
    });

    /* Ao voltar para desktop o painel some: reseta o estado */
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) alternarMenu(false);
    });
  }
</script>

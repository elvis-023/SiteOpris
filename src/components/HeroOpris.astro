---
// HERO — primeira dobra.
//
// Texto, CTAs, prova social e o painel "opris://pipeline".
//
// Esta dobra não carrega JavaScript nenhum. A coreografia de entrada é
// CSS (ver "ENTRADA DO HERO" em styles/global.css) e o split do headline
// em palavras acontece aqui, em build time. Antes os dois dependiam do
// GSAP: o anti-FOUC deixava tudo em opacity:0 e só o bundle acendia a
// luz, o que colocava ~27 KB de JS na frente do LCP.
import Button from './Button.astro';

// Headline fatiado em palavras para a revelação por máscara. Cada palavra
// precisa do próprio <span> com overflow:hidden, e o índice vai no --i
// para o CSS escalonar os atrasos.
const HEADLINE: [string, boolean][] = [
  ['O motor', false],
  ['invisível', true],   // recebe o gradiente
  ['por trás das empresas mais eficientes.', false],
];
const palavras = HEADLINE.flatMap(([trecho, grad]) =>
  trecho.split(' ').map((palavra) => ({ palavra, grad })),
);
---

<section class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 pb-16 pt-10 sm:gap-16 sm:px-6 sm:pb-24 sm:pt-14 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-32">

  <!-- ---------- COLUNA ESQUERDA ---------- -->
  <div class="lg:col-span-7">

    <!-- Tagline -->
    <div data-hero="tag" class="mb-8 inline-flex items-center gap-2.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 backdrop-blur-xs">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accenthi opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-neutral-300">
        // Sistemas inteligentes. Operações invisíveis.
      </span>
    </div>

    <!-- Headline. Uma palavra por <span class="word">, com o índice no --i:
         o CSS usa os dois para a revelação por máscara escalonada. -->
    <h1 data-hero="headline"
        class="mb-6 font-display text-[2rem] font-light leading-[1.08] tracking-tight [text-wrap:balance] sm:mb-7 sm:text-5xl md:text-[3.5rem] lg:text-[64px] lg:leading-[1.06] xl:text-[72px]">
      {palavras.map(({ palavra, grad }, i) => (
        <>
          <span class="word" style={`--i:${i}`}>
            <span class={grad ? 'text-grad' : undefined}>{palavra}</span>
          </span>{' '}
        </>
      ))}
    </h1>

    <!-- Subtítulo -->
    <p data-hero="sub" class="mb-8 max-w-xl text-[15px] leading-relaxed text-neutral-400 sm:mb-10 sm:text-lg">
      Desenvolvemos automações sob medida, softwares robustos e sites com design moderno
      que reformulam a presença digital da sua empresa. Unimos engenharia de alta
      performance para eliminar tarefas repetitivas e liberar sua
      equipe para o que realmente importa: <span class="text-neutral-200">crescer</span>.
    </p>

    <!-- CTAs -->
    <div data-hero="cta" class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">

      <!-- Primário: Beam Ring (estrutura do botão da Finex, sem as listras) -->
      <Button href="#contato" icon="cog">Automatizar minha operação</Button>

      <!-- Secundário: outline/fantasma -->
      <Button variant="ghost" href="#resultados" icon="play-circle">Ver casos de uso</Button>
    </div>

    <!-- Prova social -->
    <div data-hero="proof" class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-6 border-t border-white/5 pt-8 sm:mt-14 sm:gap-x-10">
      <div>
        <div class="font-display text-2xl font-light tracking-tight sm:text-3xl">+37h</div>
        <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">Devolvidas / mês</div>
      </div>
      <div class="hidden h-10 w-px bg-white/10 sm:block"></div>
      <div>
        <div class="font-display text-2xl font-light tracking-tight sm:text-3xl">99,9%</div>
        <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">Uptime das rotinas</div>
      </div>
      <div class="hidden h-10 w-px bg-white/10 sm:block"></div>
      <div>
        <div class="font-display text-2xl font-light tracking-tight sm:text-3xl">B2B</div>
        <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">Foco exclusivo</div>
      </div>
    </div>
  </div>

  <!-- ---------- COLUNA DIREITA ---------- -->
  <div class="relative lg:col-span-5">

    <!-- Crachás flutuantes (lg+) -->
    <div class="pointer-events-none absolute inset-0 z-20 hidden lg:block" aria-hidden="true">
      <div data-float style="--i:0" class="pill absolute -left-16 top-6 flex items-center gap-2 rounded-full px-3.5 py-2">
        <i data-lucide="webhook" class="h-3.5 w-3.5 text-accent"></i>
        <span class="font-mono text-[11px] text-neutral-200">Webhooks</span>
      </div>
      <div data-float style="--i:1" class="pill absolute -right-10 top-32 flex items-center gap-2 rounded-full px-3.5 py-2">
        <i data-lucide="plug" class="h-3.5 w-3.5 text-accent2"></i>
        <span class="font-mono text-[11px] text-neutral-200">Integração via API</span>
      </div>
      <div data-float style="--i:2" class="pill absolute -left-20 bottom-24 flex items-center gap-2 rounded-full px-3.5 py-2">
        <i data-lucide="file-text" class="h-3.5 w-3.5 text-accent"></i>
        <span class="font-mono text-[11px] text-neutral-200">Geração de PDFs</span>
      </div>
      <div data-float style="--i:3" class="pill absolute -right-6 bottom-6 flex items-center gap-2 rounded-full px-3.5 py-2">
        <i data-lucide="database" class="h-3.5 w-3.5 text-accent2"></i>
        <span class="font-mono text-[11px] text-neutral-200">Sync de dados</span>
      </div>
    </div>

    <!-- Painel: pipeline de automação -->
    <div data-hero="panel" class="electric-card relative z-10 mx-auto w-full max-w-[400px] overflow-hidden rounded-[32px] bg-neutral-900 p-[2px]">
      <!-- Borda com gradiente -->
      <div class="absolute inset-0 z-0 bg-gradient-to-b from-yellow-300 via-accent to-transparent opacity-80"></div>

      <div class="relative z-10 h-full rounded-[30px] bg-surface p-5 sm:p-7">
        <!-- Brilho interno -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-accent/10 to-transparent"></div>

        <!-- Cabeçalho -->
        <div class="relative mb-7 flex items-start justify-between">
          <span class="flex items-center gap-1.5 rounded-sm border border-white/10 bg-white/5 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-neutral-400">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accenthi opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Executando
          </span>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-600">opris://pipeline</span>
        </div>

        <!-- Etapas -->
        <div class="relative space-y-3">
          <!-- 01 Gatilho -->
          <div class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] p-3 transition-colors hover:border-accent/30">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 ring-1 ring-accent/20">
              <i data-lucide="zap" class="h-4 w-4 text-accent"></i>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-sm">Gatilho recebido</div>
              <div class="truncate font-mono text-[10px] text-neutral-500">POST /webhook · pedido.criado</div>
            </div>
            <i data-lucide="check" class="h-4 w-4 shrink-0 text-accent"></i>
          </div>

          <!-- Conector -->
          <div class="relative ml-[26px] h-5 w-px overflow-hidden bg-white/10">
            <span class="absolute inset-0 block h-full w-full bg-gradient-to-b from-transparent via-accent to-transparent"
                  style="animation: flowRun 2.8s cubic-bezier(.4,0,.2,1) infinite;"></span>
          </div>

          <!-- 02 Processamento -->
          <div class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] p-3 transition-colors hover:border-accent/30">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent2/10 ring-1 ring-accent2/20">
              <i data-lucide="cpu" class="h-4 w-4 text-accent2"></i>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-sm">Regras aplicadas</div>
              <div class="truncate font-mono text-[10px] text-neutral-500">validação · enriquecimento · ERP</div>
            </div>
            <span class="font-mono text-[10px] text-neutral-500">1.2s</span>
          </div>

          <div class="relative ml-[26px] h-5 w-px overflow-hidden bg-white/10">
            <span class="absolute inset-0 block h-full w-full bg-gradient-to-b from-transparent via-accent to-transparent"
                  style="animation: flowRun 2.8s cubic-bezier(.4,0,.2,1) .4s infinite;"></span>
          </div>

          <!-- 03 Entrega -->
          <div class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] p-3 transition-colors hover:border-accent/30">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 ring-1 ring-accent/20">
              <i data-lucide="send" class="h-4 w-4 text-accent"></i>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-sm">Entrega automática</div>
              <div class="truncate font-mono text-[10px] text-neutral-500">PDF assinado · e-mail · CRM</div>
            </div>
            <i data-lucide="check" class="h-4 w-4 shrink-0 text-accent"></i>
          </div>
        </div>

        <!-- Barra de execução -->
        <div class="mt-7">
          <div class="mb-2 flex items-baseline justify-between">
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">Execuções hoje</span>
            <span class="font-display text-lg font-light">1.284</span>
          </div>
          <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-white/5">
            <div class="absolute inset-y-0 left-0 w-[78%] rounded-full bg-gradient-to-r from-accentlo via-accent to-amber-400"></div>
            <span class="flow-pulse absolute inset-y-0 left-0 w-1/3"></span>
          </div>
        </div>

        <!-- Rodapé -->
        <div class="mt-6 flex items-center justify-between border-t border-white/5 pt-4">
          <span class="flex items-center gap-1.5 font-mono text-[10px] text-neutral-500">
            <i data-lucide="shield-check" class="h-3.5 w-3.5 text-neutral-400"></i>
            Sem intervenção manual
          </span>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-600">Opris</span>
        </div>
      </div>
    </div>

    <!-- Crachás em linha (mobile/tablet) -->
    <div class="mt-8 flex flex-wrap justify-center gap-2.5 lg:hidden">
      <span class="pill inline-flex items-center gap-2 rounded-full px-3 py-1.5">
        <i data-lucide="webhook" class="h-3.5 w-3.5 text-accent"></i>
        <span class="font-mono text-[11px] text-neutral-300">Webhooks</span>
      </span>
      <span class="pill inline-flex items-center gap-2 rounded-full px-3 py-1.5">
        <i data-lucide="plug" class="h-3.5 w-3.5 text-accent2"></i>
        <span class="font-mono text-[11px] text-neutral-300">Integração via API</span>
      </span>
      <span class="pill inline-flex items-center gap-2 rounded-full px-3 py-1.5">
        <i data-lucide="file-text" class="h-3.5 w-3.5 text-accent"></i>
        <span class="font-mono text-[11px] text-neutral-300">Geração de PDFs</span>
      </span>
    </div>
  </div>
</section>


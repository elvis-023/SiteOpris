---
// 4ª DOBRA — RESULTADOS (prova social).
//
// Faixa de métricas + três cards de depoimento. O reveal por scroll
// fica no <script> do fim do arquivo.
//
// ⚠ PLACEHOLDER — SUBSTITUIR ANTES DE PUBLICAR
// Todos os números, setores, portes e relatos abaixo são exemplos de
// ESTRUTURA, não dados reais. Troque pelos seus.
//
// Os cards são depoimentos em primeira pessoa, sem identificação do
// cliente. Cada um combina o tipo de trabalho (badge), o relato e a
// métrica de impacto.
//
// Só publique relato que um cliente real tenha dito e autorizado:
// depoimento inventado apresentado como real é publicidade enganosa
// (CDC art. 37) e cai por terra no primeiro prospect que pedir uma
// referência.
---

<section id="resultados" class="relative z-10 overflow-hidden border-t border-white/5 py-16 sm:py-24 lg:py-32">
  <div class="dot-grid-soft pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">

    <!-- Cabeçalho -->
    <header class="mb-12 max-w-2xl sm:mb-16 lg:mb-20">
      <span data-reveal="res-head" class="mb-5 inline-flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-500">
        <span class="h-px w-6 bg-accent"></span>
        Resultados
      </span>
      <h2 data-reveal="res-head" class="mb-5 text-[1.75rem] font-light leading-[1.15] tracking-tight text-white [text-wrap:balance] sm:text-4xl sm:leading-[1.08] md:text-5xl lg:text-[56px]">
        Menos planilha, <span class="text-grad">mais operação</span>
      </h2>
      <p data-reveal="res-head" class="text-[15px] leading-relaxed text-neutral-400 sm:text-base md:text-lg">
        Toda automação que colocamos no ar começou com uma planilha que alguém preenchia
        à mão. Abaixo, o que mudou na rotina de quem parou de preencher.
      </p>
    </header>

    <!-- Métricas agregadas — padrão "Metrics Grid" do design system -->
    <div class="mb-14 grid grid-cols-2 gap-x-4 gap-y-8 border-t border-white/10 pt-10 sm:mb-20 sm:gap-x-8 sm:gap-y-12 sm:pt-12 lg:grid-cols-4">
      <div data-reveal="res-metric" class="group flex cursor-default flex-col">
        <span class="mb-2 font-display text-[2rem] font-light leading-none tracking-tighter text-white transition-colors duration-300 group-hover:text-accent sm:mb-3 sm:text-4xl md:text-5xl lg:text-[4rem]">1.200h</span>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-600 transition-colors group-hover:text-white sm:text-xs sm:tracking-widest">Devolvidas por ano</span>
      </div>
      <div data-reveal="res-metric" class="group flex cursor-default flex-col">
        <span class="mb-2 font-display text-[2rem] font-light leading-none tracking-tighter text-white transition-colors duration-300 group-hover:text-accent sm:mb-3 sm:text-4xl md:text-5xl lg:text-[4rem]">31</span>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-600 transition-colors group-hover:text-white sm:text-xs sm:tracking-widest">Rotinas no ar</span>
      </div>
      <div data-reveal="res-metric" class="group flex cursor-default flex-col">
        <span class="mb-2 font-display text-[2rem] font-light leading-none tracking-tighter text-white transition-colors duration-300 group-hover:text-accent sm:mb-3 sm:text-4xl md:text-5xl lg:text-[4rem]">6</span>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-600 transition-colors group-hover:text-white sm:text-xs sm:tracking-widest">Setores atendidos</span>
      </div>
      <div data-reveal="res-metric" class="group flex cursor-default flex-col">
        <span class="mb-2 font-display text-[2rem] font-light leading-none tracking-tighter text-white transition-colors duration-300 group-hover:text-accent sm:mb-3 sm:text-4xl md:text-5xl lg:text-[4rem]">0</span>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-600 transition-colors group-hover:text-white sm:text-xs sm:tracking-widest">Projetos abandonados</span>
      </div>
    </div>

    <!-- Casos anonimizados -->
    <div class="grid grid-cols-1 gap-5 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">

      <article data-reveal="res-case" class="step-card relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/30 p-5 sm:p-7">
        <span class="beam-border-v" aria-hidden="true"></span>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:mb-6">
          <span class="rounded bg-white/5 px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-neutral-400 ring-1 ring-white/10">Geração de orçamentos</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-600">40 pessoas</span>
        </div>
        <span class="quote-mark mb-3 block text-4xl text-accent/30" aria-hidden="true">&ldquo;</span>
        <p class="mb-6 text-[14px] leading-relaxed text-neutral-300 sm:mb-7 sm:text-sm">
          Nossa equipe perdia horas montando propostas. A Opris automatizou tudo: com o
          preenchimento automático de CNPJ e integrações via webhooks, o sistema hoje gera
          o PDF final com a nossa identidade visual instantaneamente. Mudou nossa rotina.
        </p>
        <div class="flex items-end justify-between border-t border-white/5 pt-5">
          <div>
            <div class="font-display text-2xl font-light tracking-tight text-white sm:text-3xl">100%</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-500">Automatizado</div>
          </div>
          <i data-lucide="trending-up" class="h-5 w-5 text-accent"></i>
        </div>
      </article>

      <article data-reveal="res-case" class="step-card relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/30 p-5 sm:p-7">
        <span class="beam-border-v" style="animation-delay:1.6s" aria-hidden="true"></span>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:mb-6">
          <span class="rounded bg-white/5 px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-neutral-400 ring-1 ring-white/10">Integração de sistemas</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-600">120 pessoas</span>
        </div>
        <span class="quote-mark mb-3 block text-4xl text-accent/30" aria-hidden="true">&ldquo;</span>
        <p class="mb-6 text-[14px] leading-relaxed text-neutral-300 sm:mb-7 sm:text-sm">
          Tínhamos que digitar os mesmos dados em diversas plataformas diferentes, era um
          caos operacional. A Opris integrou nossos sistemas via API de forma invisível.
          A informação agora flui em tempo real e zeramos os erros de digitação.
        </p>
        <div class="flex items-end justify-between border-t border-white/5 pt-5">
          <div>
            <div class="font-display text-2xl font-light tracking-tight text-white sm:text-3xl">0</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-500">Erros humanos</div>
          </div>
          <i data-lucide="clock" class="h-5 w-5 text-accent"></i>
        </div>
      </article>

      <article data-reveal="res-case" class="step-card relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/30 p-5 sm:p-7 md:col-span-2 lg:col-span-1">
        <span class="beam-border-v" style="animation-delay:3.2s" aria-hidden="true"></span>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:mb-6">
          <span class="rounded bg-white/5 px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-neutral-400 ring-1 ring-white/10">Redesign e performance</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-600">250 pessoas</span>
        </div>
        <span class="quote-mark mb-3 block text-4xl text-accent/30" aria-hidden="true">&ldquo;</span>
        <p class="mb-6 text-[14px] leading-relaxed text-neutral-300 sm:mb-7 sm:text-sm">
          Nosso site antigo não passava a credibilidade que precisávamos para fechar
          contratos B2B. A Opris reformulou todo o visual e a engenharia do projeto.
          Ficou moderno, absurdamente rápido de carregar e virou uma verdadeira máquina
          de vendas.
        </p>
        <div class="flex items-end justify-between border-t border-white/5 pt-5">
          <div>
            <div class="font-display text-2xl font-light tracking-tight text-white sm:text-3xl">3&times;</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-500">Mais conversão</div>
          </div>
          <i data-lucide="target" class="h-5 w-5 text-accent"></i>
        </div>
      </article>
    </div>

  </div>
</section>

<script>
  /* ---------- Reveal da seção ----------
     Script de componente: módulo adiado pelo Astro, com o GSAP do CDN
     (carregado no <head> do Layout) já de pé quando isto roda. */
  import { revelarSecao } from '../scripts/reveal.js';

  revelarSecao('#resultados', (tl, { desk, headFrom, headTo }) => {
    tl.fromTo('[data-reveal="res-head"]', headFrom, headTo, 0)
      .fromTo('[data-reveal="res-metric"]',
        { opacity: 0, y: desk ? 24 : 16 },
        { opacity: 1, y: 0, duration: .7, stagger: .1 }, .3)
      .fromTo('[data-reveal="res-case"]',
        { opacity: 0, y: desk ? 36 : 24 },
        { opacity: 1, y: 0, duration: .8, stagger: .14 }, .55);
  });
</script>
